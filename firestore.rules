rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /households/{householdId} {
      allow read, update: if isHouseholdMember(householdId);
      allow create, delete: if false;

      match /members/{userId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.auth.token.email is string
          && exists(/databases/$(database)/documents/households/$(householdId)/invites/$(request.auth.token.email))
          && request.resource.data.keys().hasOnly(['id', 'role', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision'])
          && request.resource.data.id == userId
          && request.resource.data.role == 'member'
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdBy == userId
          && request.resource.data.updatedBy == userId
          && request.resource.data.revision == 1;
        allow update, delete: if false;
      }

      match /invites/{email} {
        allow get: if signedIn() && request.auth.token.email == email;
        allow list, write: if false;
      }

      match /userPreferences/{userId} {
        allow read: if isHouseholdMember(householdId) && userId == request.auth.uid;
        allow create: if isHouseholdMember(householdId)
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'accountOrder', 'defaultAccountId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision'])
          && request.resource.data.uid == userId
          && request.resource.data.accountOrder is list
          && (!request.resource.data.keys().hasAny(['defaultAccountId']) || request.resource.data.defaultAccountId is string)
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdBy == userId
          && request.resource.data.updatedBy == userId
          && request.resource.data.revision == 1;
        allow update: if isHouseholdMember(householdId)
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'accountOrder', 'defaultAccountId', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'revision'])
          && request.resource.data.uid == userId
          && request.resource.data.accountOrder is list
          && (!request.resource.data.keys().hasAny(['defaultAccountId']) || request.resource.data.defaultAccountId is string)
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == userId
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      match /accounts/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /categories/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /projects/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /transactions/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /advancePeople/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /recurringRules/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /recurringOccurrences/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /budgets/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /importBatches/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
